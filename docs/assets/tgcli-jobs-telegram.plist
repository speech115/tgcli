<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Replace every /ABSOLUTE/PATH placeholder before installing manually. -->
  <key>Label</key>
  <string>com.tgcli.jobs-telegram</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/tg</string>
    <string>--session-role</string>
    <string>job</string>
    <string>--max-runtime</string>
    <string>3000</string>
    <string>--json</string>
    <string>jobs</string>
    <string>run</string>
    <string>--rearm</string>
    <string>archive-sync</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/tgcli-jobs-telegram.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/tgcli-jobs-telegram.error.log</string>
</dict>
</plist>
