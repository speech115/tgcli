<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Replace every /ABSOLUTE/PATH placeholder before installing manually. -->
  <key>Label</key>
  <string>com.tgcli.archive-refresh</string>
  <!-- The pass carries max-runtime 3000, below StartInterval (3600) so a
       wake that finds the cap already exhausted defers sync instead of
       starting a pass that cannot finish. The cap is checked once, before
       dispatch (CONTRACT 13); it never interrupts a running pass. The hard
       bounds on a scheduled pass are the per-command caps. Keep the cap
       below the interval when you change either. -->
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/tg</string>
    <string>--json</string>
    <string>archive</string>
    <string>refresh</string>
    <string>--max-runtime</string>
    <string>3000</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/tgcli-archive-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/tgcli-archive-refresh.error.log</string>
</dict>
</plist>
